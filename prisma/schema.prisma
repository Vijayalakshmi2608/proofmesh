generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Profile {
  id                String               @id @default(uuid())
  stableId          String               @unique
  displayName       String
  email             String?
  walletAddress     String?
  role              String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  memberships       OrganizationMember[]
  tasks             Task[]               @relation("TaskSponsor")
  submissions       Submission[]         @relation("ContributorSubmissions")
  reviews           Review[]             @relation("ReviewerReviews")
  activityEvents    ActivityEvent[]     @relation("ActorActivity")
  proofAccessEvents ProofAccessEvent[]
  agentPolicies     AgentPolicy[]       @relation("AgentPolicyOwner")
  agentRequests     AgentRequest[]      @relation("AgentRequestRecipient")
  approvedAgentRequests AgentRequest[]  @relation("AgentRequestApprover")
  financialAuditEvents FinancialAudit[] @relation("AuditActor")
}

model Organization {
  id             String               @id @default(uuid())
  name           String
  slug           String               @unique
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  members        OrganizationMember[]
  tasks          Task[]
  activityEvents ActivityEvent[]
  agentPolicies  AgentPolicy[]
  financialAuditEvents FinancialAudit[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  profileId      String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile        Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@unique([organizationId, profileId])
}

model Task {
  id               String                   @id @default(uuid())
  organizationId   String
  sponsorId        String
  title            String
  summary          String
  project          String
  repositoryUrl    String?
  category         String                   @default("protocol")
  chain            String                   @default("Solana")
  status           String                   @default("draft")
  paymentAmount    Int
  currency         String                   @default("USDC")
  tokenMint        String?
  deadline         DateTime?
  disputeWindow    Int                      @default(72)
  maxSubmissions   Int                      @default(2)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sponsor          Profile                  @relation("TaskSponsor", fields: [sponsorId], references: [id])
  requirements     TaskRequirement[]
  recipes          TaskVerificationRecipe[]
  versions         TaskVersion[]
  submissions      Submission[]
  escrow           Escrow?
  proofReceipts    ProofReceipt[]
  outcomeContract  OutcomeContract?
  proofRequirement ProofRequirement?
  proofAccessEvents ProofAccessEvent[]
  agentRequests    AgentRequest[]
  activityEvents   ActivityEvent[]
  @@index([organizationId, status])
}

model TaskRequirement {
  id          String   @id @default(uuid())
  taskId      String
  label       String
  description String
  position    Int      @default(0)
  passed      Boolean  @default(false)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskVerificationRecipe {
  id          String   @id @default(uuid())
  taskId      String
  name        String
  command     String
  recipeHash  String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model OutcomeContract {
  id                 String   @id @default(uuid())
  taskId             String   @unique
  version            Int      @default(1)
  deliverablesJson   String
  acceptanceJson     String
  evidenceJson       String
  automatedChecksJson String
  humanChecksJson    String
  failureBehavior    String
  reviewerProfileId  String?
  policyVersion      String
  canonicalJson      String
  recipeHash         String
  originalPrompt     String?
  generatedDraftJson String?
  modelName          String?
  generatedAt        DateTime?
  approvedAt         DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  task               Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskVersion {
  id          String   @id @default(uuid())
  taskId      String
  version     Int
  snapshot    String
  contentHash String
  createdAt   DateTime @default(now())
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([taskId, version])
}

model Submission {
  id             String           @id @default(uuid())
  taskId         String
  contributorId  String
  status         String           @default("draft")
  note           String
  pullRequestUrl String?
  deploymentUrl  String?
  explanation    String?
  idempotencyKey String?          @unique
  submittedAt    DateTime?
  reviewedAt     DateTime?
  contentHash    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  task           Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contributor    Profile          @relation("ContributorSubmissions", fields: [contributorId], references: [id])
  evidence       EvidenceItem[]
  verificationRuns VerificationRun[]
  reviews        Review[]
  proofReceipt   ProofReceipt?
  activityEvents ActivityEvent[]
  @@index([taskId, status])
}

model EvidenceItem {
  id           String     @id @default(uuid())
  submissionId String
  type         String
  title        String
  detail       String
  href         String
  contentHash  String?
  isPrivate    Boolean    @default(false)
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model VerificationRun {
  id           String     @id @default(uuid())
  submissionId String
  status       String
  label        String
  value        String
  recipeHash   String?
  checkType    String     @default("automated")
  details      String?
  checkedAt    DateTime?
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model Review {
  id           String     @id @default(uuid())
  submissionId String
  reviewerId   String
  status       String
  comment      String?
  createdAt    DateTime   @default(now())
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewer     Profile    @relation("ReviewerReviews", fields: [reviewerId], references: [id])
}

model Escrow {
  id              String   @id @default(uuid())
  taskId          String   @unique
  status          String   @default("unfunded")
  paymentAmount   Int
  tokenMint       String?
  walletAddress   String?
  transactionHash String?
  simulated       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ProofReceipt {
  id                  String     @id @default(uuid())
  taskId              String
  submissionId        String     @unique
  contributorId       String
  status              String     @default("active")
  publicVisibility    Boolean    @default(true)
  rewardAmount        Int
  verificationHash    String
  transactionHash     String?
  contentHash         String?
  recipeHash          String?
  contributorWallet   String?
  sponsorOrganization String?
  outcomeContractHash String?
  evidenceHash        String?
  recipeVersion       Int?
  reviewerWallet      String?
  payoutSignature     String?
  credentialNetwork   String     @default("demo")
  credentialCommitment String?
  credentialProgram   String?
  issuanceSignature   String?
  revocationSignature String?
  credentialVersion   Int        @default(1)
  issuedAt            DateTime   @default(now())
  revokedAt           DateTime?
  expiresAt           DateTime?
  task                Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submission          Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  accessEvents         ProofAccessEvent[]
}

model ProofRequirement {
  id              String   @id @default(uuid())
  taskId           String   @unique
  title            String
  description      String
  requiredCategory String
  minActiveProofs  Int      @default(1)
  ruleJson         String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model ProofAccessEvent {
  id             String       @id @default(uuid())
  proofReceiptId String
  taskId         String
  contributorId  String
  eventType      String
  createdAt      DateTime     @default(now())
  proofReceipt   ProofReceipt @relation(fields: [proofReceiptId], references: [id], onDelete: Cascade)
  task           Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contributor    Profile      @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  @@index([contributorId, createdAt])
}

model AgentPolicy {
  id                 String   @id @default(uuid())
  organizationId     String
  ownerId            String
  name               String
  maxBudget          Int
  allowedCategories  String
  allowedRecipients  String
  approvalThreshold  Int
  enabled            Boolean  @default(true)
  simulated          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner              Profile  @relation("AgentPolicyOwner", fields: [ownerId], references: [id])
  requests           AgentRequest[]
  @@index([organizationId, enabled])
}

model AgentRequest {
  id                  String   @id @default(uuid())
  policyId            String
  taskId              String
  recipientId         String
  requestedAmount     Int
  status              String   @default("pending")
  requiresHumanApproval Boolean @default(true)
  approvedById        String?
  decisionComment     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  policy              AgentPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  task                Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  recipient           Profile  @relation("AgentRequestRecipient", fields: [recipientId], references: [id])
  approvedBy          Profile? @relation("AgentRequestApprover", fields: [approvedById], references: [id])
  @@index([taskId, status])
}

model FinancialAudit {
  id             String   @id @default(uuid())
  organizationId String?
  actorId        String?
  action         String
  entityType     String
  entityId       String
  amount         Int?
  status         String
  metadataJson   String
  createdAt      DateTime @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          Profile? @relation("AuditActor", fields: [actorId], references: [id])
  @@index([organizationId, createdAt])
}

model ActivityEvent {
  id             String        @id @default(uuid())
  organizationId String?
  actorId        String?
  taskId         String?
  submissionId   String?
  kind           String
  title          String
  detail         String
  color          String
  href           String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          Profile?      @relation("ActorActivity", fields: [actorId], references: [id])
  task           Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submission     Submission?   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}
